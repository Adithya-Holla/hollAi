PORT=5000
MONGODB_URI=
NODE_ENV=development
JWT_SECRET=

# Email delivery.
# Sent over Resend's HTTPS API — Render's free tier blocks outbound SMTP,
# so a direct smtp.gmail.com connection fails with ETIMEDOUT.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Before a domain is verified, the
# only permitted sender is onboarding@resend.dev, and Resend will deliver
# only to the account owner's own address.
EMAIL_FROM=hollAi Contact <onboarding@resend.dev>
# Where contact-form notifications are delivered.
EMAIL_TO=

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
